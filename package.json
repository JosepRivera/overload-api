{
	"name": "overload-api",
	"version": "0.0.1",
	"author": "JosepRivera",
	"packageManager": "pnpm@11.10.0",
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"scripts": {
		"start:dev": "tsx watch src/main.ts",
		"build": "nest build",
		"lint": "biome check --write ./src ./test",
		"dev": "docker compose up",
		"dev:build": "docker compose up --build",
		"stop": "docker compose down",
		"db:migrate": "docker exec -it overload-app-dev pnpm prisma migrate dev",
		"db:gen": "docker exec overload-app-dev pnpm prisma generate",
		"db:seed": "docker exec overload-app-dev pnpm tsx prisma/seed.ts",
		"db:reset": "docker exec -it overload-app-dev pnpm prisma migrate reset",
		"shell": "docker exec -it overload-app-dev sh",
		"clean": "docker compose down -v",
		"test": "vitest run --project unit",
		"test:e2e": "docker compose -f compose.test.yaml up --build --abort-on-container-exit --exit-code-from app-test --remove-orphans",
		"test:e2e:down": "docker compose -f compose.test.yaml down -v"
	},
	"dependencies": {
		"@nestjs/common": "^11.1.28",
		"@nestjs/config": "^4.0.4",
		"@nestjs/core": "^11.1.28",
		"@nestjs/platform-express": "^11.1.28",
		"@nestjs/swagger": "^11.4.5",
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"bcrypt": "^6.0.0",
		"dotenv": "^17.4.2",
		"helmet": "^8.2.0",
		"jose": "^6.2.3",
		"ms": "^2.1.3",
		"nestjs-zod": "^5.4.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@nestjs/cli": "^11.0.24",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.1.28",
		"@swc/cli": "^0.8.1",
		"@swc/core": "^1.15.43",
		"@swc/helpers": "^0.5.23",
		"@types/bcrypt": "^6.0.0",
		"@types/express": "^5.0.6",
		"@types/ms": "^2.1.0",
		"@types/node": "^26.1.1",
		"@types/supertest": "^7.2.0",
		"prisma": "^7.8.0",
		"supertest": "^7.2.2",
		"tsx": "^4.23.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	}
}
