{
	"name": "overload-server",
	"version": "0.0.1",
	"author": "JosepRivera",
	"packageManager": "pnpm@11.20.0",
	"engines": {
		"node": ">=24.0.0 <25"
	},
	"scripts": {
		"start": "nest start --watch",
		"build": "nest build",
		"lint": "biome check --write ./src ./test",
		"dev": "docker compose up",
		"dev:build": "pnpm install && docker compose up --build",
		"dev:stop": "docker compose down",
		"dev:clean": "docker compose down -v",
		"db:seed": "docker exec overload-app-dev pnpm tsx prisma/seed.ts",
		"db:reset": "docker exec -it overload-app-dev pnpm prisma migrate reset",
		"db:migrate": "docker exec -it overload-app-dev pnpm prisma migrate dev --name",
		"test": "vitest run --project unit",
		"test:e2e": "docker compose -f compose.test.yaml up --build --abort-on-container-exit --exit-code-from app-test --remove-orphans",
		"test:e2e:down": "docker compose -f compose.test.yaml down -v",
		"docs:build": "pnpm --filter apps-docs build",
		"docs:preview": "pnpm --filter apps-docs preview"
	},
	"dependencies": {
		"@nestjs/common": "^11.1.29",
		"@nestjs/core": "^11.1.29",
		"@nestjs/platform-express": "^11.1.29",
		"@nestjs/swagger": "^11.4.6",
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@scalar/nestjs-api-reference": "^1.2.13",
		"bcrypt": "^6.0.0",
		"dotenv": "^17.4.2",
		"helmet": "^8.3.0",
		"jose": "^6.2.8",
		"nestjs-zod": "^5.5.0",
		"prisma": "^7.9.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@nestjs/cli": "^11.0.24",
		"@nestjs/schematics": "^11.1.0",
		"@nestjs/testing": "^11.1.29",
		"@swc/cli": "^0.8.1",
		"@swc/core": "^1.15.47",
		"@swc/helpers": "^0.5.23",
		"@types/bcrypt": "^6.0.0",
		"@types/express": "^5.0.6",
		"@types/node": "^24.13.3",
		"@types/supertest": "^7.2.1",
		"supertest": "^7.2.2",
		"tsx": "^4.23.12",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	}
}
